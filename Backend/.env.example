PORT=4000
MQTT_URL=mqtts://localhost:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
MQTT_CLIENT_ID=sankatnet-backend
MQTT_TOPIC_ROOT=sankatnet
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DATA_FILE=./data/telemetry.json
DATABASE_URL=postgresql://postgres:password@localhost:5432/sankatnet
AUTH_USERNAME=operator
# Use a long unique password. Never commit the real value.
AUTH_PASSWORD=replace-with-a-long-unique-password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=28800
# Optional: enables generated answers after local RAG retrieval. Without this key,
# the backend returns a grounded local answer and sends no live data externally.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
 LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=15000

# Set true only while onboarding new operator accounts.
ALLOW_REGISTRATION=false

# Required only when ALLOW_REGISTRATION=true and an administrator account is being created.
ADMIN_REGISTRATION_CODE=
