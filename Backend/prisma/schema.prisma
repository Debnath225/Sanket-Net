generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Record {
  id        BigInt   @id @default(autoincrement())
  kind      String
  createdAt DateTime @default(now()) @map("created_at")
  payload   Json

  @@index([kind, createdAt(sort: Desc)])
  @@map("sankat_records")
}